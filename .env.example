# Configurações do Briefing Form App
# Copie este arquivo para .env.local se desejar utilizar integrações personalizadas

# Webhook para notificação em tempo real (Discord, Slack, Zapier ou Make)
# WEBHOOK_URL=https://discord.com/api/webhooks/...

# E-mail de destino das respostas do formulário (opcional)
# NOTIFICATION_EMAIL=seu-email@suaempresa.com.br
